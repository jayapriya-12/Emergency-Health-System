// Prisma Schema for Smart Emergency Hospital & Ambulance System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  name          String
  phone         String?
  role          String          @default("PATIENT") // PATIENT, HOSPITAL, AMBULANCE_DRIVER, ADMIN
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  patient       Patient?
  hospital      Hospital?
  driver        AmbulanceDriver?
  notifications Notification[]
}

model Patient {
  id                    String             @id @default(uuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                   Int?
  bloodGroup            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  latitude              Float?
  longitude             Float?
  medicalNotes          String?

  emergencyRequests     EmergencyRequest[]
  trips                 Trip[]
}

model Hospital {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  phone                String?
  emergencyPhone       String?
  address              String
  latitude             Float
  longitude            Float
  isVerified           Boolean            @default(true)
  totalBeds            Int                @default(50)
  availableBeds        Int                @default(20)
  totalICUBeds         Int                @default(10)
  availableICUBeds     Int                @default(4)
  totalVentilators     Int                @default(5)
  availableVentilators Int                @default(2)
  emergencyDeptStatus  String             @default("OPEN") // OPEN, BUSY, CLOSED
  oxygenAvailable      Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  ambulances           Ambulance[]
  emergencyRequests    EmergencyRequest[]
  facilities           HospitalFacility[]
  trips                Trip[]
}

model Ambulance {
  id                String             @id @default(uuid())
  vehicleNumber     String             @unique
  vehicleModel      String
  type              String             @default("ALS") // BASIC, BLS, ALS, ICU_MOBILE
  hospitalId        String?
  hospital          Hospital?          @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  status            String             @default("AVAILABLE") // AVAILABLE, ON_TRIP, OFFLINE, MAINTENANCE
  latitude          Float              @default(0.0)
  longitude         Float              @default(0.0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  driver            AmbulanceDriver?
  emergencyRequests EmergencyRequest[]
  trips             Trip[]
}

model AmbulanceDriver {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber      String
  experienceYears    Int                @default(3)
  status             String             @default("AVAILABLE") // AVAILABLE, ON_TRIP, OFFLINE
  latitude           Float              @default(0.0)
  longitude          Float              @default(0.0)
  currentAmbulanceId String?            @unique
  ambulance          Ambulance?         @relation(fields: [currentAmbulanceId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  emergencyRequests  EmergencyRequest[]
  trips              Trip[]
}

model EmergencyRequest {
  id                   String           @id @default(uuid())
  patientId            String
  patient              Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId           String?
  hospital             Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  driverId             String?
  driver               AmbulanceDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  ambulanceId          String?
  ambulance            Ambulance?       @relation(fields: [ambulanceId], references: [id], onDelete: SetNull)
  status               String           @default("PENDING") // PENDING, ACCEPTED_BY_HOSPITAL, DRIVER_ASSIGNED, EN_ROUTE_TO_PATIENT, PATIENT_PICKED_UP, EN_ROUTE_TO_HOSPITAL, REACHED_HOSPITAL, COMPLETED, CANCELLED, REJECTED
  emergencyType        String           @default("GENERAL") // CARDIAC, ACCIDENT, PREGNANCY, GENERAL, RESPIRATORY, STROKE, UNCONSCIOUS
  severity             String           @default("HIGH") // CRITICAL, HIGH, MEDIUM, LOW
  pickupLatitude       Float
  pickupLongitude      Float
  pickupAddress        String
  destinationLatitude  Float?
  destinationLongitude Float?
  destinationAddress   String?
  notes                String?
  requestedAt          DateTime         @default(now())
  acceptedAt           DateTime?
  completedAt          DateTime?
  updatedAt            DateTime         @updatedAt

  trips                Trip[]
}

model HospitalFacility {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  facilityName String
  isAvailable Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id        String   @id @default(uuid())
  entityId  String
  entityType String  // PATIENT, DRIVER, AMBULANCE, HOSPITAL
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  timestamp DateTime @default(now())
}

model Trip {
  id                 String           @id @default(uuid())
  emergencyRequestId String
  emergencyRequest   EmergencyRequest @relation(fields: [emergencyRequestId], references: [id], onDelete: Cascade)
  driverId           String?
  driver             AmbulanceDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  ambulanceId        String?
  ambulance          Ambulance?       @relation(fields: [ambulanceId], references: [id], onDelete: SetNull)
  patientId          String
  patient            Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId         String?
  hospital           Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  status             String           @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  startLatitude      Float
  startLongitude     Float
  endLatitude        Float?
  endLongitude       Float?
  startTime          DateTime         @default(now())
  endTime            DateTime?
  distanceKm         Float?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, EMERGENCY
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
